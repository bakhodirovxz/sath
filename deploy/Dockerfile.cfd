# CFD worker: OpenFOAM v2406 + GES server kodi (ges-worker). Kontekst: repo ildizi.
# CI-03: bazaviy obrazlar digest bilan qotirilgan (teg — o'qish uchun, digest — haqiqiy manba). Yangilash
# (renovate uslubi): docker buildx imagetools inspect <obraz:teg> → yangi digest, testdan keyin almashtiring.
FROM opencfd/openfoam-default:2406@sha256:dd5aa20630a55722663bf83ba0cb74870cba130081303e32e3865007fa2aa35a
USER root
ARG PIP_TRUSTED_HOST=""
# GES_DATABASE_URL compose dan (server bilan bir xil Postgres) — SQLite default YO'Q: worker server bazasini
# ko'rmasa ishlamaydi (worker.check_database_url). JWT kaliti kerak emas; /data da faqat cfd/ hajmi.
ENV PIP_TRUSTED_HOST=$PIP_TRUSTED_HOST PYTHONUNBUFFERED=1 \
    GES_DATA_DIR=/data GES_CFD_MODE=local GES_SECRET_KEY_REQUIRED=false
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY sim/ ./sim/
COPY server/ ./server/
RUN python3 -m venv /venv && /venv/bin/pip install --no-cache-dir -c ./server/requirements.lock ./sim "./server[postgres]"
# Root siz (L5): ges obrazi bilan bir xil uid — /data hajmi umumiy
RUN useradd --system --uid 10001 --create-home --home-dir /home/sath sath \
    && mkdir -p /data/cfd && chown -R sath:sath /data
USER sath
# OpenFOAM muhiti + worker
CMD ["bash", "-c", "source /openfoam/bash.rc 2>/dev/null; exec /venv/bin/ges-worker"]
