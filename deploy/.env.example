# Tashqi port
GES_PORT=8000

# Birinchi ishga tushishda admin foydalanuvchi. Bo'sh qoldirsangiz tasodifiy parol
# yaratilib /data/initial-admin-password.txt ga yoziladi (docker compose logs ges).
GES_ADMIN_USERNAME=admin
GES_ADMIN_PASSWORD=

# JWT kaliti. Bo'sh bo'lsa avtomatik yaratilib /data/secret.key da saqlanadi.
GES_SECRET_KEY=

# Postgres ishlatsangiz (--profile postgres):
# GES_DATABASE_URL=postgresql+psycopg://ges:ges@postgres:5432/ges
# POSTGRES_PASSWORD=ges

# Web manzili — email va bildirishnoma havolalari uchun (HTTPS bo'lsa https://<GES_DOMAIN>)
GES_PUBLIC_URL=http://ges-server:8000

# HTTPS (--profile https, Caddy): domen/hostname; brauzerda https://<GES_DOMAIN>
GES_DOMAIN=ges-server

# Email (ixtiyoriy): smtp://user:pass@mail.company.uz:587?from=ges@company.uz  (smtps:// — SSL)
# GES_SMTP_URL=

# Maksimal IFC hajmi (MB)
GES_MAX_UPLOAD_MB=2048

# CFD (OpenFOAM): off | docker | worker
#   docker — ges serveri Docker orqali OpenFOAM ni o'zi ishga tushiradi (faqat server konteynerdan tashqarida ishlaganda)
#   worker — alohida `cfd` servis (docker compose --profile cfd up -d), tavsiya etiladi
GES_CFD_MODE=worker
CFD_CPUS=4

# MQTT broker (ixtiyoriy): mqtt://user:pass@broker:1883
# GES_MQTT_URL=

# Historian: xom o'lchovlar necha kun saqlanadi (soatlik agregat abadiy); 0 — o'chirilmaydi
GES_READINGS_RETENTION_DAYS=90
# Stale (aloqa uzilgan) tekshiruvi davri, soniya
GES_MONITOR_INTERVAL_S=30

# Yuklashdan keyin fonda geometriya tahlili (QTO, to'qnashuvlar) va fragments (.frag) konvertatsiya
GES_PRECOMPUTE_GEOMETRY=true
GES_FRAGMENTS_ENABLED=true
# Kunlik hisobot emaili (UTC soat; -1 — o'chirilgan) — muhandis/tasdiqlovchi/dispetcherlarga (SMTP bo'lsa)
GES_DAILY_REPORT_HOUR=6
# Tashqi konverterlar papkasi (dwg2dxf / ODAFileConverter — DWG, assimp — FBX/3DS, blender — .blend);
# ko'rsatilmasa PATH, ~/Tools, C:\Tools va h.k. tekshiriladi (docs/admin.md)
#GES_TOOLS_DIR=
