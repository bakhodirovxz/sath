# Tashqi port va bog'lanish manzili. Default 127.0.0.1 (OPS-01): 8000 port faqat shu hostdan, tashqariga —
# HTTPS profili (Caddy) orqali; TLS chegarasi aylanib o'tilmaydi. Caddy siz sinov stendida: GES_BIND=0.0.0.0
GES_PORT=8000
GES_BIND=127.0.0.1

# Tezlik cheklovlari (daqiqasiga; 0 — o'chirilgan) va hisobni bloklash (L1)
# GES_RATE_LOGIN_PER_MIN=30          # IP bo'yicha login urinishlari
# GES_RATE_INGEST_PER_MIN=600        # loyiha bo'yicha POST readings/soe so'rovlari
# GES_RATE_COMMANDS_PER_MIN=60       # foydalanuvchi bo'yicha buyruq select/execute
# GES_RATE_SIM_PER_MIN=20            # foydalanuvchi bo'yicha sim ishlari
# GES_LOGIN_MAX_FAILURES=10          # ketma-ket noto'g'ri parol/MFA → bloklash
# GES_LOGIN_LOCKOUT_MINUTES=15
# Caddy (--profile https) ortida klient IP ni X-Forwarded-For dan olish; to'g'ridan-to'g'ri ochiq serverda false!
# GES_RATE_TRUST_FORWARDED=true
# Administratorlar uchun TOTP MFA majburiy (Profil → MFA yoqilmaguncha admin amallari 403)
# GES_MFA_REQUIRED_FOR_ADMINS=true
# Sessiyalar (L2): access token muddati (daqiqa), refresh/sessiya muddati (soat), WS qayta avtorizatsiya (s),
# parol minimal uzunligi (tavsiya 12)
# GES_ACCESS_TOKEN_MINUTES=15
# GES_REFRESH_TOKEN_HOURS=12
# GES_WS_REAUTH_S=300
# WebSocket (L4): bo'sh turish chegarasi (klient pong yubormasa, s), foydalanuvchi bo'yicha ulanishlar,
# backplane (ko'p replika): auto — Postgres bo'lsa LISTEN/NOTIFY | pg | off
# GES_WS_IDLE_S=90
# GES_WS_MAX_PER_USER=8
# GES_LIVE_BACKPLANE=auto
# GES_PASSWORD_MIN_LENGTH=8

# Birinchi ishga tushishda admin foydalanuvchi. Bo'sh qoldirsangiz tasodifiy parol
# yaratilib /data/initial-admin-password.txt ga yoziladi (docker compose logs ges).
# Parol siyosatidan o'tmaydigan parol (masalan admin123) berilsa admin birinchi kirishda uni almashtirishi
# shart (CODE-08); startda logda ogohlantirish.
GES_ADMIN_USERNAME=admin
GES_ADMIN_PASSWORD=

# JWT kaliti. Bo'sh bo'lsa avtomatik yaratilib /data/secret.key da saqlanadi.
GES_SECRET_KEY=

# Ishlab chiqish/sinov rejimi (CODE-08): zaif admin/DB parollari faqat ogohlantirish beradi. Ishlab
# chiqarishda HECH QACHON yoqmang. Lokal dev: GES_DEV_MODE=true GES_ADMIN_PASSWORD=admin123 (desktop/tests)
# GES_DEV_MODE=false

# Ma'lumotlar bazasi: default — compose dagi Postgres+TimescaleDB (POSTGRES_PASSWORD bilan).
# Faqat ishlab chiqish/sinov uchun SQLite: GES_DATABASE_URL=sqlite:////data/ges.db
# Tashqi Postgres: GES_DATABASE_URL=postgresql+psycopg://ges:parol@host:5432/ges
# Startda sxema migratsiyasi (Alembic) avtomatik; ishlab chiqarishda qo'lda boshqarish uchun false
# (u holda `alembic upgrade head` ni siz bajarasiz, aks holda server ishga tushmaydi)
# GES_AUTO_MIGRATE=true
# Postgres paroli MAJBURIY (CODE-08): bo'lmasa compose ishga tushmaydi; default/zaif parol ("ges", "postgres",
# ...) bilan server ham ishga tushmaydi (GES_DEV_MODE=true dan tashqari). Masalan: openssl rand -base64 24
POSTGRES_PASSWORD=

# Web manzili — email va bildirishnoma havolalari uchun (Caddy HTTPS profili: https://<GES_DOMAIN>)
GES_PUBLIC_URL=https://ges-server

# Desktop paketlari imzosi (SEC-03): nashr qiluvchining Ed25519 ochiq kaliti (publish_desktop.py --gen-key)
# GES_DESKTOP_SIGNING_PUBLIC_KEY=
# GES_DESKTOP_REQUIRE_SIGNATURE=true

# HTTPS (--profile https, Caddy): domen/hostname; brauzerda https://<GES_DOMAIN>
GES_DOMAIN=ges-server

# Email (ixtiyoriy): smtp://user:pass@mail.company.uz:587?from=ges@company.uz  (smtps:// — SSL)
# GES_SMTP_URL=

# Maksimal IFC hajmi (MB); kichik yuklashlar (CSV import, BCF) chegarasi; konteyner xotira chegarasi
GES_MAX_UPLOAD_MB=2048
# GES_SMALL_UPLOAD_MB=50
# GES_MEM_LIMIT=6g
# CFD_MEM_LIMIT=8g
# Ishonchsiz CAD/IFC parserlari sandboxi (L5): auto (Linux: bwrap → rlimit) | bwrap | rlimit | off
# GES_SANDBOX=auto

# CFD (OpenFOAM): off | docker | worker
#   docker — ges serveri Docker orqali OpenFOAM ni o'zi ishga tushiradi (faqat server konteynerdan tashqarida ishlaganda)
#   worker — alohida `cfd` servis (docker compose --profile cfd up -d), tavsiya etiladi
#   worker server bilan bir xil DB ga ulanadi (GES_DATABASE_URL, default — compose Postgres; SQLite bilan
#   ishlamaydi) va faqat cfd_data hajmini (/data/cfd) ko'radi — .env dagi sirlar unga berilmaydi
GES_CFD_MODE=worker
CFD_CPUS=4
# docker rejimi (server o'zi docker run qiladi): konteyner xotirasi; timeoutda konteyner docker kill bilan to'xtatiladi
# GES_CFD_MEMORY=8g
# GES_CFD_TIMEOUT_S=10800

# MQTT broker (ixtiyoriy). Ishlab chiqarishda mqtts:// + CA; TLS siz mqtt:// faqat loopback ga,
# boshqa hostga GES_MQTT_ALLOW_INSECURE=true bilan (ochiq matn xavfi qabul qilinadi). Parol URL da EMAS.
# GES_MQTT_URL=mqtts://broker:8883
# GES_MQTT_USERNAME=sath
# GES_MQTT_PASSWORD=            # yoki GES_MQTT_PASSWORD_FILE=/run/secrets/mqtt_password
# GES_MQTT_CA_FILE=/etc/sath/mqtt-ca.pem
# GES_MQTT_CERT_FILE=           # mTLS (ixtiyoriy) — kalit bilan birga
# GES_MQTT_KEY_FILE=
# Obuna ruxsati: vergul bilan MQTT filtrlar, {project_id} o'rinbosari; default "#" (hammasi)
# GES_MQTT_TOPIC_ALLOW=sath/{project_id}/#
# Partiyalash: xabarlar soni / ms bo'yicha bitta tranzaksiya
# GES_MQTT_BATCH_SIZE=200
# GES_MQTT_BATCH_MS=250

# Historian qatlamlari: xom → 1 daqiqa → 10 daqiqa → 1 soat (abadiy). Saqlash muddati, kun; 0 — o'chirilmaydi.
# Xom o'lchov alarm hodisasi atrofida (±1 soat) o'chirilmaydi.
GES_READINGS_RETENTION_DAYS=90
# GES_AGG_1M_RETENTION_DAYS=400
# GES_AGG_10M_RETENTION_DAYS=1100
# SOE (hodisalar ketma-ketligi) saqlash muddati, kun
# GES_SOE_RETENTION_DAYS=1100
# Jonli ingest ts oynasi: bundan eski (kun) yoki kelajakdagi (soniya) qiymat rad etiladi
# GES_INGEST_MAX_AGE_DAYS=30
# GES_INGEST_FUTURE_S=300
# Analitik simulyatsiya: alohida jarayon + vaqt chegarasi; foydalanuvchi bo'yicha faol ishlar soni
# GES_SIM_ISOLATE=true
# GES_SIM_TIMEOUT_S=300
# GES_SIM_MAX_ACTIVE_PER_USER=3
# GES_SIM_MAX_ACTIVE_PER_PROJECT=10
# Ish navbati (L3): jarayon ichidagi ishchi bir vaqtda nechta ish bajaradi (sim + fragments/geometriya), tekshiruv davri
# GES_JOBS_CONCURRENCY=2
# GES_JOBS_POLL_S=2
# Rol (L8): all (default) | api (faqat HTTP/WS, ko'p replika — docker-compose.ha.yml) | worker (fon + navbat)
# GES_ROLE=all
# PG_REPL_PASSWORD=   # postgres-replica profili (deploy/pg-replica/README.md)
# Buyruq watchdog: gateway olgan buyruqqa shuncha soniyada javob kelmasa failed
# GES_COMMAND_SENT_TIMEOUT_S=120
# Stale (aloqa uzilgan) tekshiruvi davri, soniya
GES_MONITOR_INTERVAL_S=30

# Yuklashdan keyin fonda geometriya tahlili (QTO, to'qnashuvlar) va fragments (.frag) konvertatsiya
GES_PRECOMPUTE_GEOMETRY=true
GES_FRAGMENTS_ENABLED=true
# Kunlik hisobot emaili (UTC soat; -1 — o'chirilgan) — muhandis/tasdiqlovchi/dispetcherlarga (SMTP bo'lsa)
GES_DAILY_REPORT_HOUR=6
# Tashqi konverterlar papkasi (dwg2dxf / ODAFileConverter — DWG, assimp — FBX/3DS, blender — .blend);
# ko'rsatilmasa PATH, ~/Tools, C:\Tools va h.k. tekshiriladi (docs/admin.md)
#GES_TOOLS_DIR=
# Relyef (DEM) plitkalari — tashqi AWS kanali (docs/security-zones.md C5): so'rovda ob'ekt joylashuvi (plitka
# koordinatalari) uchinchi tomonga ketadi. Yopiq stansiyada o'chiring yoki ichki ko'zgu bering.
# Webdan yaratilgan yangi modellar IFC sxemasi (G1): IFC4 (default) | IFC4X3_ADD2 (ISO 16739-1:2024, infratuzilma entitylari)
# GES_IFC_SCHEMA=IFC4
# IDS axborot talablari fayli (G2) — Model → Tekshiruv → IDS
# GES_IDS_FILE=docs/ids/sath-ges.ids
# GES_DEM_ENABLED=true
# GES_DEM_TILE_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
